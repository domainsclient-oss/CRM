# dependencies
node_modules/
.pnpm-store/

# env files — never commit real values; .env.example holds placeholders only
.env*
!.env.example

# build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# testing
coverage/
playwright-report/
test-results/
blob-report/

# deployment / tooling
.vercel/
.turbo/

# firebase
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
database-debug.log*
pubsub-debug.log*
emulator-data/

# credentials — service-account keys must never be committed (requirements/04 §11)
*service-account*.json
*-sa-key.json
*.pem

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/

# local portable tooling (e.g. JDK for Firebase emulators)
.tools/

# Cloud Functions bundle
functions/lib/

# Generated SBOM (pnpm sbom)
sbom.cdx.json

# Load-test inputs (staging credentials / build-specific IDs)
load/users.json
load/actions.json

# ZAP reports
security/zap/*.html

# Real UAT pilot config (emails of pilot users)
uat/pilot.json
