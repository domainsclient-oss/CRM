# Placeholders only — copy to .env.local and fill in. Never commit real values.
# Full variable list: requirements/12-environment-and-configuration.md §3

# Firebase web config (public by design; restrict the API key by HTTP referrer + API in Google Cloud Console)
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<app-id>

# ---------------------------------------------------------------------------
# App (requirements/12 §3)
# ---------------------------------------------------------------------------
APP_ENV=local
APP_INSTANCE=local
APP_MARKETING_HOST=www.localhost:3000
APP_BASE_DOMAIN=app.localhost:3000
APP_CONSOLE_HOST=console.localhost:3001
APP_PARTNERS_HOST=partners.localhost:3001
APP_ASSETS_BASE_URL=http://localhost:3000
APP_PLATFORM_STAFF_DOMAINS=example.com

# Sessions (__Host- prefix needs HTTPS; local uses a plain name)
APP_SESSION_COOKIE_NAME=session
APP_SESSION_MAX_AGE_DAYS=5
APP_REAUTH_WINDOW_SECONDS=300
APP_TENANT_CACHE_TTL_SECONDS=60
APP_CONSOLE_SESSION_MAX_AGE_HOURS=8
APP_PARTNERS_SESSION_MAX_AGE_HOURS=12

# ---------------------------------------------------------------------------
# Firebase / Google Cloud — server only (never NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_PRIVATE_BUCKET=$NEXT_PUBLIC_FIREBASE_PROJECT_ID-private
FIREBASE_STORAGE_BRAND_BUCKET=$NEXT_PUBLIC_FIREBASE_PROJECT_ID-brand-assets

# Credentials for the Admin SDK when running locally against the real dev project:
# preferred: run `gcloud auth application-default login` (no key file needed).
# Alternative: service-account key from the DEV project (set both, never commit real values):
# FIREBASE_CLIENT_EMAIL=<sa-name>@<project-id>.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
<key>
-----END PRIVATE KEY-----
"
# Hosted (Vercel) uses OIDC federation — set these only in Vercel, not here:
# GCP_PROJECT_NUMBER=
# GCP_WORKLOAD_IDENTITY_POOL_ID=
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# GCP_SERVICE_ACCOUNT_EMAIL=

# Firebase Emulator Suite — uncomment to use emulators instead of the real project
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# NEXT_PUBLIC_USE_AUTH_EMULATOR=true

# ---------------------------------------------------------------------------
# Signing secrets (random, local only)
# ---------------------------------------------------------------------------
CURSOR_SIGNING_SECRET=<generate: openssl rand -base64 32>
CSRF_SECRET=<generate: openssl rand -base64 32>
UNSUBSCRIBE_SIGNING_SECRET=<generate: openssl rand -base64 32>

# ---------------------------------------------------------------------------
# Integrations (local mocks)
# ---------------------------------------------------------------------------
RATE_LIMIT_BACKEND=memory
# RATE_LIMIT_REDIS_URL=
# RATE_LIMIT_REDIS_TOKEN=
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@mail.example.com
# EMAIL_PROVIDER_API_KEY=
PAYMENTS_ENABLED_PROVIDERS=razorpay,paypal,stripe
PAYMENTS_SECRET_PREFIX=agy_
TEST_GATEWAY_MOCKS=true
TEST_VERCEL_DOMAINS_MOCK=true
# VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_WEB_PROJECT_ID=
# SENTRY_DSN=

LOG_LEVEL=debug
