rules_version = '2';

// MVP (ADR-003): the browser never reads or writes Firestore directly.
// All data access goes through the server with the Admin SDK, which bypasses
// these rules; server-side authorization is the primary control.
// PROTECTED FILE (requirements/08 §8): changes need Security review + human approval (H3).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
