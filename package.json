{
  "name": "crm",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "emulators": "node scripts/with-java.mjs firebase emulators:start --project demo-crm",
    "test": "vitest run --project node --project dom --project dom-web --project dom-console",
    "test:watch": "vitest --project node --project dom --project dom-web --project dom-console",
    "test:coverage": "node scripts/with-java.mjs firebase emulators:exec --project demo-crm --only auth,firestore,storage \"vitest run --project node --project dom --project dom-web --project dom-console --project integration --project registry --coverage\"",
    "test:e2e": "playwright test",
    "perf:lighthouse": "node scripts/lighthouse.mjs",
    "scan:bundles": "node scripts/scan-bundles.mjs",
    "sbom": "node scripts/sbom.mjs",
    "uat:seed": "tsx --conditions=react-server scripts/uat-seed.ts",
    "env:parity": "tsx --conditions=react-server scripts/env-parity.ts",
    "ops": "tsx scripts/ops.ts",
    "restore:drill": "tsx --conditions=react-server scripts/restore-drill.ts",
    "test:e2e:smoke": "playwright test --project=chromium-desktop",
    "test:rules": "node scripts/with-java.mjs firebase emulators:exec --project demo-crm --only firestore,storage \"vitest run --project rules\"",
    "seed": "tsx scripts/seed-emulator.ts",
    "env:sync": "tsx scripts/env-sync.ts",
    "indexes:gen": "tsx scripts/gen-indexes.ts",
    "test:integration": "node scripts/with-java.mjs firebase emulators:exec --project demo-crm --only auth,firestore,storage \"vitest run --project integration --project registry\"",
    "test:e2e:auth": "node scripts/with-java.mjs firebase emulators:exec --project demo-crm --only auth,firestore,storage \"node scripts/e2e-emulated.mjs\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@crm/core": "workspace:*",
    "@crm/shared": "workspace:*",
    "@crm/testing": "workspace:*",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.33.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.7"
  }
}
